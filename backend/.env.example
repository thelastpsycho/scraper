# Copy to backend/.env and generate independent random secrets:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ACCESS_TOKEN=replace-with-a-random-token-at-least-32-characters-long
APP_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-chars
# Bind Flask to loopback; use a same-origin proxy for remote users.
APP_HOST=127.0.0.1
APP_DEBUG=0
# Set to 1 when serving over HTTPS; requires secure browser cookies.
APP_SECURE_COOKIES=0
# Explicit one-machine development ONLY: APP_HOST must be loopback; no login.
# ALLOW_INSECURE_LOCAL_DEV=1

# Optional provider credentials (never use VITE_* for these values).
PMS_USERNAME=
PMS_PASSWORD=
DEDGE_USERNAME=
DEDGE_PASSWORD=
